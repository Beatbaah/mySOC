# Copy to .env and fill in. Never commit .env.

# Database password (any long random string)
POSTGRES_PASSWORD=

# Encrypts stored API keys. Generate one:
#   python3 -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
MYSOC_VAULT_KEY=

# First admin. Leave the password empty to get a one-time password in
# `docker compose logs api`; you'll change it and set up 2-step at first sign-in.
MYSOC_BOOTSTRAP_ADMIN_USERNAME=admin
MYSOC_BOOTSTRAP_ADMIN_PASSWORD=

# demo = synthetic office network with a replayed intrusion (default)
# capture = live traffic (see docker-compose.capture.yml)
MYSOC_SENSOR_SOURCE=demo
MYSOC_SYSLOG_ENABLED=false

# Set to your https:// address when deploying behind TLS, and MYSOC_ENV=production
MYSOC_PUBLIC_ORIGIN=http://localhost:8080
MYSOC_ENV=development
