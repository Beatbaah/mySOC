# MY SOC — Environment Configuration Example
# Copy this to .env and fill in your keys

# ─── Database ─────────────────────────────────────────────────────────────────
DB_PATH=soc_data.db

# ─── Network Capture ──────────────────────────────────────────────────────────
# Interface to listen on (e.g., eth0, wlan0). Leave blank for auto-detection.
CAPTURE_INTERFACE=

# ─── Syslog Receiver ──────────────────────────────────────────────────────────
SYSLOG_HOST=0.0.0.0
SYSLOG_PORT=514

# ─── Threat Intelligence APIs ──────────────────────────────────────────────────
# Get keys at: https://www.abuseipdb.com/, https://otx.alienvault.com/, https://www.virustotal.com/
ABUSEIPDB_API_KEY=
ALIENVAULT_API_KEY=
VIRUSTOTAL_API_KEY=

# ─── Email Alerts (SMTP) ───────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=soc-alerts@example.com
ALERT_EMAIL_TO=admin@example.com,security@example.com

# ─── Telegram Alerts ───────────────────────────────────────────────────────────
# Create a bot via @BotFather to get a token
TELEGRAM_BOT_TOKEN=
# Get your chat ID via @userinfobot
TELEGRAM_CHAT_IDS=

# ─── GeoIP ─────────────────────────────────────────────────────────────────────
# Download GeoLite2-City.mmdb from MaxMind and place in project root
GEOIP_DB_PATH=GeoLite2-City.mmdb

# ─── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ─── Whitelisting ──────────────────────────────────────────────────────────────
WHITELIST_IPS=127.0.0.1,::1
